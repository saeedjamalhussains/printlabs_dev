{
  "name": "the-print-labs-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.8.2",
  "description": "ThePrintLabs \u2014 poster store, admin dashboard, backend and Fabi assistant.",
  "workspaces": [
    "apps/*",
    "shared/packages/*"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -n server,store,admin,assistant -c blue,green,magenta,cyan \"npm:dev:server\" \"npm:dev:store\" \"npm:dev:admin\" \"npm:dev:assistant\"",
    "dev:server": "npm run dev -w @printlabs/server",
    "dev:store": "npm run dev -w @printlabs/store",
    "dev:admin": "npm run dev -w @printlabs/admin",
    "dev:assistant": "node shared/scripts/dev-assistant.js",
    "build": "turbo run build",
    "build:store": "npm run build -w @printlabs/store",
    "build:admin": "npm run build -w @printlabs/admin",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "generate:schemas": "npm run generate:json --workspace @printlabs/schemas",
    "start:server": "npm run start -w @printlabs/server",
    "create-admin": "npm run create-admin -w @printlabs/server",
    "audit:log": "npm run audit -w @printlabs/server",
    "test:security": "npm run test:security -w @printlabs/server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "turbo": "^2.5.0"
  }
}
