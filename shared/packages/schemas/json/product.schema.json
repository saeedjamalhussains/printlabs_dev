{
  "type": "object",
  "properties": {
    "_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "minimum": 0
    },
    "category": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "variants": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "publicId": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": true
      }
    },
    "stock": {
      "type": "integer",
      "minimum": 0
    },
    "sizes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "priceModifier": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "label"
        ],
        "additionalProperties": true
      }
    },
    "isActive": {
      "type": "boolean"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "title",
    "price",
    "category",
    "images",
    "stock",
    "sizes"
  ],
  "additionalProperties": true,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
